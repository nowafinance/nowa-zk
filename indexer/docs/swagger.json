{
    "swagger": "2.0",
    "info": {
        "description": "REST API for the Nowa-ZK Rollup Indexer",
        "title": "Nowa-ZK Indexer API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Redirects to Swagger UI",
                "tags": [
                    "Meta"
                ],
                "summary": "List available endpoints",
                "responses": {
                    "302": {
                        "description": "Found"
                    }
                }
            }
        },
        "/batch/latest": {
            "get": {
                "description": "Returns the most recently created batch",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Batches"
                ],
                "summary": "Get latest batch",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.Batch"
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/batch/{number}": {
            "get": {
                "description": "Returns a specific batch by its number",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Batches"
                ],
                "summary": "Get batch by number",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Batch Number",
                        "name": "number",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.Batch"
                        }
                    },
                    "400": {
                        "description": "Invalid ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Checks if the service is up",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Meta"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/prover/batch/latest": {
            "get": {
                "description": "Returns the latest batch including execution traces for the prover",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Prover"
                ],
                "summary": "Get latest batch for prover",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.Batch"
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/prover/batch/{number}": {
            "get": {
                "description": "Returns a specific batch including execution traces for the prover",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Prover"
                ],
                "summary": "Get batch by number for prover",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Batch Number",
                        "name": "number",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.Batch"
                        }
                    },
                    "400": {
                        "description": "Invalid ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "description": "Returns current status, batch count, and batch data range",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Meta"
                ],
                "summary": "Get indexer status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "big.Int": {
            "type": "object"
        },
        "rpc.Transaction": {
            "type": "object",
            "properties": {
                "blockHash": {
                    "type": "string"
                },
                "blockNumber": {
                    "$ref": "#/definitions/big.Int"
                },
                "contractAddress": {
                    "description": "Set for contract deployments",
                    "type": "string"
                },
                "from": {
                    "type": "string"
                },
                "gas": {
                    "type": "integer"
                },
                "gasPrice": {
                    "$ref": "#/definitions/big.Int"
                },
                "hash": {
                    "type": "string"
                },
                "input": {
                    "type": "string"
                },
                "isContractDeployment": {
                    "description": "True if this is a contract deployment",
                    "type": "boolean"
                },
                "maxFeePerGas": {
                    "description": "EIP-1559",
                    "allOf": [
                        {
                            "$ref": "#/definitions/big.Int"
                        }
                    ]
                },
                "maxPriorityFeePerGas": {
                    "description": "EIP-1559",
                    "allOf": [
                        {
                            "$ref": "#/definitions/big.Int"
                        }
                    ]
                },
                "nonce": {
                    "type": "integer"
                },
                "to": {
                    "description": "Empty for contract deployments",
                    "type": "string"
                },
                "transactionIndex": {
                    "type": "integer"
                },
                "value": {
                    "$ref": "#/definitions/big.Int"
                }
            }
        },
        "types.Batch": {
            "type": "object",
            "properties": {
                "hash": {
                    "type": "string"
                },
                "newStateRoot": {
                    "type": "string"
                },
                "number": {
                    "type": "integer"
                },
                "oldStateRoot": {
                    "type": "string"
                },
                "status": {
                    "description": "\"pending\", \"proving\", \"ready\", \"submitted\"",
                    "type": "string"
                },
                "timestamp": {
                    "type": "integer"
                },
                "traces": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/types.ExecutionTrace"
                    }
                },
                "trades": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/types.ParsedTrade"
                    }
                },
                "transactions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/rpc.Transaction"
                    }
                }
            }
        },
        "types.ExecutionTrace": {
            "type": "object",
            "properties": {
                "contractAddress": {
                    "description": "Set for contract deployments",
                    "type": "string"
                },
                "from": {
                    "type": "string"
                },
                "isContractDeployment": {
                    "description": "True if this is a contract deployment",
                    "type": "boolean"
                },
                "newBalance": {
                    "type": "string"
                },
                "nonce": {
                    "type": "integer"
                },
                "oldBalance": {
                    "type": "string"
                },
                "to": {
                    "description": "Empty for contract deployments",
                    "type": "string"
                },
                "txHash": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "types.ParsedTrade": {
            "type": "object",
            "properties": {
                "messageHash": {
                    "type": "string"
                },
                "pubKeyX": {
                    "type": "string"
                },
                "pubKeyY": {
                    "type": "string"
                },
                "sigR": {
                    "type": "string"
                },
                "sigS": {
                    "type": "string"
                },
                "signerAddress": {
                    "type": "string"
                }
            }
        }
    }
}