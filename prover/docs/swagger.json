{
    "swagger": "2.0",
    "info": {
        "description": "API for the Tan-ZK Rollup Prover",
        "title": "Tan-ZK Prover API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Redirects to Swagger UI",
                "tags": [
                    "Meta"
                ],
                "summary": "List available endpoints",
                "responses": {
                    "302": {
                        "description": "Found"
                    }
                }
            }
        },
        "/batches/latest": {
            "get": {
                "description": "Get details of the latest verified batch from the contract",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Batches"
                ],
                "summary": "Get latest verified batch",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.BatchResponse"
                        }
                    },
                    "404": {
                        "description": "No batches found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/batches/{id}": {
            "get": {
                "description": "Get details of a specific batch",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Batches"
                ],
                "summary": "Get batch by ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Batch ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.BatchResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid batch ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/proof/{id}": {
            "get": {
                "description": "Get full proof data for a batch",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Proofs"
                ],
                "summary": "Get proof data",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Batch ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_tannetwork_zk-sequencer_prover_internal_storage.ProofData"
                        }
                    },
                    "400": {
                        "description": "Invalid batch ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Proof not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Database error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/status/{id}": {
            "get": {
                "description": "Get proof generation status for a batch",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Proofs"
                ],
                "summary": "Get proof status",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Batch ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.StatusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid batch ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_tannetwork_zk-sequencer_prover_internal_storage.ProofData": {
            "type": "object",
            "properties": {
                "batch_number": {
                    "type": "integer"
                },
                "proof": {},
                "timestamp": {
                    "type": "integer"
                },
                "witness": {}
            }
        },
        "internal_api.BatchResponse": {
            "type": "object",
            "properties": {
                "batchHash": {
                    "type": "string"
                },
                "batchNumber": {
                    "type": "integer"
                },
                "newStateRoot": {
                    "type": "string"
                },
                "oldStateRoot": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "submitter": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "integer"
                },
                "verifiedAt": {
                    "type": "integer"
                }
            }
        },
        "internal_api.StatusResponse": {
            "type": "object",
            "properties": {
                "batch_number": {
                    "type": "integer"
                },
                "note": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "integer"
                }
            }
        }
    }
}